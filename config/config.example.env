# Copy this file to config/config.env and fill in what you already know.
# Anything left blank is simply asked for interactively by the wizard.
#
# NEVER commit config/config.env — it's already in .gitignore. This file
# (config.example.env) should never contain real values either.
#
# This file is read as shell, so put any value containing $, spaces, quotes,
# & or ! inside SINGLE quotes, e.g.  CONTABO_API_PASSWORD='p$ss w0rd'
# Unquoted, a "$" is silently expanded and the password arrives wrong,
# which the Contabo API reports as a generic authentication failure.
# (A value that itself contains a single quote cannot be stored here — type
# it when the wizard asks instead.)

# --- Source server (old cPanel box) ---
SOURCE_HOST=
SOURCE_SSH_PORT=22
SOURCE_SSH_USER=root
SOURCE_SSH_KEY=

# --- Target server (new Contabo VPS running Webmin/Virtualmin) ---
TARGET_HOST=
TARGET_SSH_PORT=22
TARGET_SSH_USER=root
TARGET_SSH_KEY=
TARGET_PUBLIC_IP=

# --- Optional: shared SSH deploy key installed on every migrated account ---
DEPLOY_PUBLIC_KEY=

# --- Contabo API (only needed if you want automated DNS cutover) ---
# client_id / client_secret: Contabo panel -> API Management -> OAuth2 Clients
# API_USER: your Contabo login email
# API_PASSWORD: a DEDICATED API password from Security & Access -> Password ->
#               Send Link. This is NOT your normal account login password —
#               using the wrong one fails silently (an empty access token)
#               rather than with a clear authentication error.
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
